    "@wdio/local-runner": "^9.31.4",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/types": "^9.31.2",
    "appium": "^3.7.0",
    "tsx": "^4.23.12",
    "webdriverio": "^9.31.4"
