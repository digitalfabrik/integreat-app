    "intl-pluralrules": "^2.0.1",
    "js-sha256": "^1.1.0",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "react": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.2",
    "react-native": "0.88.1",
    "react-native-blob-util": "^1.1.1",
    "react-native-calendar-events": "^2.2.0",
    "react-native-color-matrix-image-filters": "^8.0.2",
    "react-native-gesture-handler": "^3.5.0",
