{
  "name": "translations",
  "version": "0.0.1",
  "description": "Translations for the integreat frontend projects",
  "private": true,
  "type": "module",
  "scripts": {
    "manage": "tsx src/manage.ts",
    "export": "yarn manage export src/translations integreat-csv",
    "export:malte": "yarn manage export src/override-translations/malte malte-csv",
    "export:aschaffenburg": "yarn manage export src/override-translations/aschaffenburg aschaffenburg-csv",
    "export:obdach": "yarn manage export src/override-translations/obdach obdach-csv",
    "import": "yarn manage import integreat-csv src/translations",
    "import:malte": "yarn manage import malte-csv src/override-translations/malte",
    "import:aschaffenburg": "yarn manage import aschaffenburg-csv src/override-translations/aschaffenburg",
    "import:obdach": "yarn manage import obdach-csv src/override-translations/obdach",
    "csv-to-ods": "./tools/csv-to-ods",
    "ods-to-csv": "./tools/ods-to-csv",
    "sync": "yarn manage sync",
    "validate": "yarn manage validate",
    "check": "yarn sync && git diff --exit-code src && yarn validate",
    "test": "jest --config jest.config.ts",
    "lint": "eslint --cache --cache-location ../.eslintcache .",
    "ts:check": "tsc --build",
    "check-circular-dependencies": "yarn run -T check-circular-dependencies"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./override-translations/*": {
      "import": "./src/override-translations/*/index.ts",
      "types": "./src/override-translations/*/index.d.ts",
      "default": "./src/override-translations/*/index.ts"
    }
  },
  "dependencies": {
    "deepmerge-ts": "^8.0.1"
  },
  "devDependencies": {
    "@types/flat": "^5.0.5",
    "@types/lodash-es": "^4.17.12",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "flat": "^5.0.2",
    "lodash-es": "^4.18.1",
    "tsx": "^4.23.12"
  }
}
