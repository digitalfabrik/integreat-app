    "build:aschaffenburg": "cross-env CONFIG_NAME=aschaffenburg vite build",
    "build:obdach": "cross-env CONFIG_NAME=obdach vite build",
    "check:build": "yarn es-check es2022 ./build/**/*.js --verbose --module",
    "test": "yarn run -T jest",
    "lint": " yarn stylelint && yarn run -T eslint --cache --cache-location ../.eslintcache .",
    "stylelint": "npx stylelint --config stylelint.config.js \"src/**/*.{ts,tsx,css}\"",
    "ts:check": "yarn run -T tsc --build",
    "check-circular-dependencies": "yarn run -T check-circular-dependencies",
    "prettier:check": "yarn run -T prettier --ignore-path  ../.prettierignore --check .",
    "prettier:write": "yarn run -T prettier --ignore-path  ../.prettierignore --write .",
    "circleci:update-config": "yarn run -T circleci:update-config",
    "postinstall": "yarn run -T tsx ../tools/licenses.ts --node-modules='..'"
  },
